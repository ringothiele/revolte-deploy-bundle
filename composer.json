{
    "name": "revolte/contao-deploy-tools",
    "description": "Internes Contao-Deployment-Tool für Revolte-Projekte",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/process": "^5.4 || ^6.4 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "contao/manager-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Revolte\\DeployTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revolte\\DeployTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Revolte\\DeployTools\\ContaoManager\\Plugin"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "allow-plugins": {
            "contao/manager-plugin": true
        }
    }
}
