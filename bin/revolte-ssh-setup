#!/usr/bin/env bash
# revolte-ssh-setup — SSH-Einrichtung für eine Deploy-Umgebung (v2)
#
# Aufruf im Projektroot:
#   vendor/bin/revolte-ssh-setup <umgebung> [optionen]
#   vendor/bin/revolte-ssh-setup <umgebung> --check
#
# Prinzipien:
#   - Pro Lauf maximal EIN Verbindungstest (BatchMode, genau ein Key) — fail2ban-Schutz
#   - Nach fehlgeschlagenem Test: 35 min Cooldown, kein automatischer Neuversuch
#   - Passphrase-Abfragen nur durch ssh-keygen / ddev auth ssh (laufen direkt im Script)
#   - Idempotent: kann jederzeit erneut ausgeführt werden
#   - Portabel: Bash 3.2 (macOS) und Linux/WSL2
#
# Details: vendor/revolte/contao-deploy-tools/docs/umbauplan-ssh-setup.md

set -euo pipefail

# ── Konstanten ────────────────────────────────────────────────────────────────
CONFIG_DIR="${HOME}/.config/revolte"
IDENTITY_CONF="${CONFIG_DIR}/identity.conf"
TEAM_CONF="${CONFIG_DIR}/team.conf"
COOLDOWN_DIR="${CONFIG_DIR}/ssh-cooldown"
COOLDOWN_MINUTES=35
SSH_CONFIG="${HOME}/.ssh/config"
HOMEADD_CONF=".ddev/homeadditions/.ssh/config.d/revolte.conf"
HOMEADD_KEYDIR=".ddev/homeadditions/.ssh/revolte-keys"
YAML_FILE="config/revolte_deploy.yaml"

# ── Ausgabe-Helfer ────────────────────────────────────────────────────────────
G='\033[0;32m'; Y='\033[1;33m'; R='\033[0;31m'; B='\033[0;34m'; NC='\033[0m'
ok()    { echo -e " ${G}✓${NC}  $*"; }
warn()  { echo -e " ${Y}!${NC}  $*"; }
info()  { echo -e " ${B}→${NC}  $*"; }
step()  { echo -e "\n${B}── $* ──${NC}"; }
err()   { echo -e " ${R}✗${NC}  $*" >&2; exit 1; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# confirm "Frage" → 0 bei ja; respektiert --yes
confirm() {
    [[ "$ASSUME_YES" -eq 1 ]] && return 0
    local a
    read -r -p " $1 [j/N] " a
    a=$(lower "$a")
    [[ "$a" == "j" || "$a" == "ja" || "$a" == "y" ]]
}

# ask "Frage" "default" → Wert auf stdout
ask() {
    local v
    if [[ -n "${2:-}" ]]; then
        read -r -p " $1 [$2]: " v
        printf '%s' "${v:-$2}"
    else
        read -r -p " $1: " v
        printf '%s' "$v"
    fi
}

ask_required() {
    # Läuft in Command-Substitution — alles außer dem Wert muss auf stderr
    local v=""
    while [[ -z "$v" ]]; do
        v=$(ask "$1" "${2:-}")
        [[ -n "$v" ]] || warn "Eingabe darf nicht leer sein." >&2
    done
    printf '%s' "$v"
}

usage() {
    cat <<'EOF'
revolte-ssh-setup — SSH-Einrichtung für eine Deploy-Umgebung

Aufruf (im Projektroot):
  vendor/bin/revolte-ssh-setup <umgebung> [optionen]

Modi:
  (Standard)        Umgebung einrichten (interaktiv, Flags übersteuern Prompts)
  --check           Nur Diagnose, keine Änderungen (max. 1 Verbindungstest nach Rückfrage)

Optionen:
  --host <host>     Server-Hostname oder IP
  --port <port>     SSH-Port (Standard: 22)
  --user <user>     SSH-Benutzer
  --path <pfad>     Remote-Pfad auf dem Server
  --branch <name>   Branch für diese Umgebung (Standard: stage→develop, live→main)
  --profile <name>  SSH-Profilname (Standard: {projekt}-{umgebung})
  --account <name>  Server-Account für die Key-Benennung (z.B. revolte-labor)
  --key <pfad>      Vorhandenen Key verwenden statt Namenskonvention
  --skip-test       Verbindungstest überspringen (z.B. bei aktivem fail2ban-Bann)
  --yes, -y         Bestätigungsfragen automatisch mit ja beantworten
  --help, -h        Diese Hilfe

Beispiele:
  vendor/bin/revolte-ssh-setup stage
  vendor/bin/revolte-ssh-setup live --host kunde.example.com --port 22 \
      --user k12345 --path /www/htdocs/k12345/live --account kunde-x
  vendor/bin/revolte-ssh-setup stage --check
EOF
}

# ── Argumente ─────────────────────────────────────────────────────────────────
ENV_NAME=""
MODE="setup"
ASSUME_YES=0
SKIP_TEST=0
OPT_HOST=""; OPT_PORT=""; OPT_USER=""; OPT_PATH=""; OPT_BRANCH=""
OPT_PROFILE=""; OPT_ACCOUNT=""; OPT_KEY=""

optval() { [[ -n "${2:-}" ]] || err "Option $1 braucht einen Wert (siehe --help)"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)      MODE="check" ;;
        --yes|-y)     ASSUME_YES=1 ;;
        --skip-test)  SKIP_TEST=1 ;;
        --host)       optval "$1" "${2:-}"; OPT_HOST="$2"; shift ;;
        --port)       optval "$1" "${2:-}"; OPT_PORT="$2"; shift ;;
        --user)       optval "$1" "${2:-}"; OPT_USER="$2"; shift ;;
        --path)       optval "$1" "${2:-}"; OPT_PATH="$2"; shift ;;
        --branch)     optval "$1" "${2:-}"; OPT_BRANCH="$2"; shift ;;
        --profile)    optval "$1" "${2:-}"; OPT_PROFILE="$2"; shift ;;
        --account)    optval "$1" "${2:-}"; OPT_ACCOUNT="$2"; shift ;;
        --key)        optval "$1" "${2:-}"; OPT_KEY="$2"; shift ;;
        --help|-h)    usage; exit 0 ;;
        -*)           err "Unbekannte Option: $1 (siehe --help)" ;;
        *)            [[ -z "$ENV_NAME" ]] && ENV_NAME="$1" || err "Mehrere Umgebungen angegeben: '$ENV_NAME' und '$1'" ;;
    esac
    shift
done

[[ -n "$ENV_NAME" ]] || { usage; echo ""; err "Bitte eine Umgebung angeben (z.B. stage, live)."; }
ENV_NAME=$(lower "$ENV_NAME")

# ── Projekt erkennen ──────────────────────────────────────────────────────────
[[ -f ".ddev/config.yaml" ]] || err "Nicht im Projektroot (.ddev/config.yaml fehlt). Bitte aus dem Projektverzeichnis aufrufen."

PROJECT_NAME=$(awk -F': *' '/^name:/ { gsub(/["'"'"']/, "", $2); print $2; exit }' .ddev/config.yaml)
[[ -n "$PROJECT_NAME" ]] || err "Projektname konnte nicht aus .ddev/config.yaml gelesen werden."

mkdir -p "$CONFIG_DIR" "$COOLDOWN_DIR"

# ── SSH-Config-Helfer ────────────────────────────────────────────────────────
# get_profile_field <datei> <profil> <feld-kleingeschrieben>
get_profile_field() {
    [[ -f "$1" ]] || return 0
    awk -v p="$2" -v f="$3" '
        /^Host[[:space:]]/ { inb = ($2 == p) }
        inb && tolower($1) == f { print $2; exit }
    ' "$1"
}

profile_exists_in() {
    [[ -f "$1" ]] && awk -v p="$2" '/^Host[[:space:]]/ && $2 == p { found = 1 } END { exit !found }' "$1"
}

# drop_profile_block <datei> <profil> — entfernt den Host-Block
drop_profile_block() {
    local tmp
    tmp=$(mktemp)
    awk -v p="$2" '
        /^Host[[:space:]]/ { skip = ($2 == p) }
        !skip { print }
    ' "$1" > "$tmp" && mv "$tmp" "$1"
}

# ── Cooldown (fail2ban-Schutz) ────────────────────────────────────────────────
cooldown_file() { printf '%s' "${COOLDOWN_DIR}/${SRV_HOST}_${SRV_PORT}"; }

cooldown_remaining_min() {
    local f last now rest
    f=$(cooldown_file)
    [[ -f "$f" ]] || { echo 0; return; }
    last=$(cat "$f" 2>/dev/null || echo 0)
    now=$(date +%s)
    rest=$(( COOLDOWN_MINUTES - (now - last) / 60 ))
    [[ "$rest" -gt 0 ]] && echo "$rest" || echo 0
}

cooldown_set()   { date +%s > "$(cooldown_file)"; }
cooldown_clear() { rm -f "$(cooldown_file)"; }

# ── Verbindungstest (max. einer pro Lauf, klassifiziert) ─────────────────────
# Rückgabe: 0 = ok, 1 = Key abgelehnt, 2 = Netz/Bann, 3 = unklar
run_connection_test() {
    local out
    info "Teste Verbindung zu '$PROFIL' (BatchMode, ein Versuch) ..."
    out=$(ddev exec ssh -o BatchMode=yes -o ConnectTimeout=10 "$PROFIL" "echo REVOLTE_OK" 2>&1 || true)

    if echo "$out" | grep -q "REVOLTE_OK"; then
        cooldown_clear
        ok "SSH-Verbindung zu '$PROFIL' funktioniert."
        return 0
    fi

    cooldown_set

    if echo "$out" | grep -qi "permission denied"; then
        warn "Server hat den Key abgelehnt (Permission denied)."
        echo ""
        echo "   Wahrscheinliche Ursachen:"
        echo "   - Public Key ist (noch) nicht in ~/.ssh/authorized_keys auf dem Server"
        echo "   - Falscher SSH-Benutzer im Profil (aktuell: ${SRV_USER})"
        echo ""
        echo -e "   ${Y}WICHTIG:${NC} Jetzt NICHT weiter probieren — jeder Fehlversuch"
        echo "   verlängert einen möglichen fail2ban-Bann. Cooldown: ${COOLDOWN_MINUTES} min."
        echo ""
        echo "   Nächster Schritt: Key auf dem Server prüfen/eintragen, dann nach"
        echo "   Ablauf des Cooldowns:  vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
        return 1
    fi

    if echo "$out" | grep -Eqi "timed out|connection refused|no route to host|could not resolve|connection closed by remote host|connection reset"; then
        warn "Server nicht erreichbar (Timeout/Verbindung abgelehnt)."
        echo ""
        echo "   Mögliche Ursachen:"
        echo "   - fail2ban-Bann aktiv (Hetzner sperrt schnell und eskalierend)"
        echo "   - Falscher Host/Port (aktuell: ${SRV_HOST}:${SRV_PORT})"
        echo "   - Netzwerk/VPN-Problem"
        echo ""
        echo -e "   ${Y}WICHTIG:${NC} ${COOLDOWN_MINUTES} min warten, KEINE weiteren Versuche."
        echo "   Danach:  vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
        return 2
    fi

    warn "Verbindung fehlgeschlagen — unklares Fehlerbild:"
    echo "$out" | while IFS= read -r line; do [[ -n "$line" ]] && echo "     $line"; done
    echo ""
    echo "   Cooldown gesetzt (${COOLDOWN_MINUTES} min). Bitte Fehlermeldung prüfen,"
    echo "   dann:  vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
    return 3
}

# ══════════════════════════════════════════════════════════════════════════════
# CHECK-MODUS — read-only Diagnose
# ══════════════════════════════════════════════════════════════════════════════
if [[ "$MODE" == "check" ]]; then
    echo ""
    echo -e "${B}=== Revolte SSH-Check: ${PROJECT_NAME} / ${ENV_NAME} ===${NC}"

    FAIL=0

    step "Identität"
    KUERZEL=""
    [[ -f "$IDENTITY_CONF" ]] && KUERZEL=$(awk -F'=' '/^KUERZEL=/ { print $2; exit }' "$IDENTITY_CONF")
    if [[ -n "$KUERZEL" ]]; then
        ok "Entwicklerkürzel: $KUERZEL ($IDENTITY_CONF)"
    else
        warn "Kein Entwicklerkürzel hinterlegt — Setup-Modus fragt es einmalig ab."
        FAIL=1
    fi

    step "revolte_deploy.yaml"
    PROFIL=""; REMOTE_PATH=""; ENV_BRANCH=""
    if [[ -f "$YAML_FILE" ]] && grep -q "^  ${ENV_NAME}:" "$YAML_FILE"; then
        PROFIL=$(awk -v env="$ENV_NAME" '
            /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
            in_env && /^    ssh_profile: / { sub(/^    ssh_profile: /, ""); print; exit }
        ' "$YAML_FILE")
        REMOTE_PATH=$(awk -v env="$ENV_NAME" '
            /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
            in_env && /^    remote_path: / { sub(/^    remote_path: /, ""); print; exit }
        ' "$YAML_FILE")
        ENV_BRANCH=$(awk -v env="$ENV_NAME" '
            /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
            in_env && /^    branch: / { sub(/^    branch: /, ""); print; exit }
        ' "$YAML_FILE")
        ok "Umgebung '$ENV_NAME' eingetragen:"
        echo "      ssh_profile: ${PROFIL:-(fehlt)}"
        echo "      remote_path: ${REMOTE_PATH:-(fehlt)}"
        echo "      branch:      ${ENV_BRANCH:-(fehlt)}"
        [[ -n "$PROFIL" && -n "$REMOTE_PATH" ]] || FAIL=1
    else
        warn "Umgebung '$ENV_NAME' nicht in $YAML_FILE — Setup-Modus ausführen."
        FAIL=1
    fi

    step "~/.ssh/config (Host)"
    KEY_PATH=""
    if [[ -n "$PROFIL" ]] && profile_exists_in "$SSH_CONFIG" "$PROFIL"; then
        SRV_HOST=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "hostname")
        SRV_PORT=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "port"); SRV_PORT="${SRV_PORT:-22}"
        SRV_USER=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "user")
        KEY_PATH=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "identityfile")
        KEY_PATH="${KEY_PATH/#\~/$HOME}"
        IDONLY=$(lower "$(get_profile_field "$SSH_CONFIG" "$PROFIL" "identitiesonly")")
        ok "Profil '$PROFIL': ${SRV_USER:-?}@${SRV_HOST:-?}:${SRV_PORT}"
        if [[ "$IDONLY" == "yes" ]]; then
            ok "IdentitiesOnly yes gesetzt (nur ein Key wird angeboten)"
        else
            warn "IdentitiesOnly fehlt — SSH bietet ALLE Agent-Keys an (fail2ban-Risiko!)"
            FAIL=1
        fi
    else
        warn "Profil '${PROFIL:-?}' nicht in $SSH_CONFIG."
        FAIL=1
    fi

    step "SSH-Key"
    if [[ -n "$KEY_PATH" && -f "$KEY_PATH" && -f "${KEY_PATH}.pub" ]]; then
        ok "Key vorhanden: $KEY_PATH"
    else
        warn "Key oder Public Key fehlt: ${KEY_PATH:-(kein IdentityFile im Profil)}"
        FAIL=1
    fi

    step "Container-Config (homeadditions)"
    if [[ -n "$PROFIL" ]] && profile_exists_in "$HOMEADD_CONF" "$PROFIL"; then
        C_IDFILE=$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "identityfile")
        C_IDONLY=$(lower "$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "identitiesonly")")
        if [[ -n "$C_IDFILE" && "$C_IDONLY" == "yes" ]]; then
            ok "Container-Profil mit festem Key: $C_IDFILE"
        else
            warn "Container-Profil ohne IdentityFile/IdentitiesOnly — bietet alle Agent-Keys an (fail2ban-Risiko!)"
            FAIL=1
        fi
    else
        warn "Container-Profil '$PROFIL' fehlt in $HOMEADD_CONF."
        FAIL=1
    fi

    if git rev-parse --git-dir >/dev/null 2>&1 && git ls-files --error-unmatch "$HOMEADD_CONF" >/dev/null 2>&1; then
        warn "$HOMEADD_CONF ist in Git getrackt — enthält entwicklerspezifische Profile."
        echo "      → git rm -r --cached .ddev/homeadditions/.ssh"
        FAIL=1
    fi

    step "ddev & Agent"
    if ! ddev describe >/dev/null 2>&1; then
        warn "ddev läuft nicht — bitte 'ddev start', dann erneut prüfen."
        FAIL=1
    elif [[ -n "$KEY_PATH" && -f "${KEY_PATH}.pub" ]]; then
        KEY_FP=$(ssh-keygen -lf "${KEY_PATH}.pub" 2>/dev/null | awk '{print $2}')
        AGENT_KEYS=$(ddev exec ssh-add -l 2>/dev/null || true)
        if [[ -n "$KEY_FP" ]] && echo "$AGENT_KEYS" | grep -q "$KEY_FP"; then
            ok "Key ist im ddev-Agent geladen."
        else
            warn "Key nicht im ddev-Agent — bitte ausführen: ddev auth ssh"
            FAIL=1
        fi
    fi

    step "Verbindung"
    UNVERIFIED=1
    if [[ -z "${SRV_HOST:-}" ]]; then
        warn "Kein Host bekannt — Verbindungstest nicht möglich."
    else
        REST=$(cooldown_remaining_min)
        if [[ "$REST" -gt 0 ]]; then
            warn "Cooldown aktiv: noch ${REST} min (fail2ban-Schutz) — kein Verbindungstest."
        elif [[ "$FAIL" -ne 0 ]]; then
            warn "Verbindungstest übersprungen — erst die obigen Punkte beheben."
        elif [[ "$SKIP_TEST" -eq 1 ]]; then
            info "Verbindungstest übersprungen (--skip-test)."
        elif confirm "Verbindungstest ausführen (genau 1 Versuch)?"; then
            if run_connection_test; then
                UNVERIFIED=0
            else
                FAIL=1
            fi
        else
            info "Verbindungstest übersprungen."
        fi
    fi

    echo ""
    if [[ "$FAIL" -ne 0 ]]; then
        echo -e "${Y}=== Check mit offenen Punkten — siehe Markierungen oben ===${NC}"
        exit 1
    elif [[ "$UNVERIFIED" -eq 1 ]]; then
        echo -e "${Y}=== Lokale Konfiguration vollständig — Verbindung noch ungeprüft ===${NC}"
        exit 0
    else
        echo -e "${G}=== Check bestanden — Umgebung '$ENV_NAME' ist einsatzbereit ===${NC}"
        exit 0
    fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# SETUP-MODUS
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "${B}=== Revolte SSH-Setup: ${PROJECT_NAME} / ${ENV_NAME} ===${NC}"

# ── Identität (einmalig) ─────────────────────────────────────────────────────
KUERZEL=""
[[ -f "$IDENTITY_CONF" ]] && KUERZEL=$(awk -F'=' '/^KUERZEL=/ { print $2; exit }' "$IDENTITY_CONF")

if [[ -z "$KUERZEL" ]]; then
    step "Einmalige Einrichtung (nur beim ersten Lauf)"
    KUERZEL=$(lower "$(ask_required "Dein Entwicklerkürzel (z.B. rt, pl, sl)")")
    printf 'KUERZEL=%s\n' "$KUERZEL" > "$IDENTITY_CONF"
    ok "Gespeichert in $IDENTITY_CONF — wird nie wieder abgefragt."
fi

# ── Team-Defaults laden (nur für stage relevant) ─────────────────────────────
STAGE_HOST=""; STAGE_PORT=""; STAGE_ACCOUNT=""; STAGE_PATH_TEMPLATE=""
if [[ -f "$TEAM_CONF" ]]; then
    # shellcheck disable=SC1090
    . "$TEAM_CONF"
fi

# ── Werte auflösen: Flags > Team-Defaults > Prompt ───────────────────────────
step "Umgebungsdaten"

DEF_HOST=""; DEF_PORT="22"; DEF_ACCOUNT=""; DEF_PATH=""
if [[ "$ENV_NAME" == "stage" && -n "$STAGE_HOST" ]]; then
    DEF_HOST="$STAGE_HOST"
    DEF_PORT="${STAGE_PORT:-22}"
    DEF_ACCOUNT="$STAGE_ACCOUNT"
    [[ -n "$STAGE_PATH_TEMPLATE" ]] && DEF_PATH="${STAGE_PATH_TEMPLATE//\{project\}/$PROJECT_NAME}"
    info "Team-Defaults für stage geladen ($TEAM_CONF)."
fi

case "$ENV_NAME" in
    stage) DEF_BRANCH="develop" ;;
    *)     DEF_BRANCH="main" ;;
esac

PROFIL="${OPT_PROFILE:-${PROJECT_NAME}-${ENV_NAME}}"
SRV_HOST="${OPT_HOST:-$(ask_required "Server-Hostname oder IP" "$DEF_HOST")}"
SRV_PORT="${OPT_PORT:-$(ask_required "SSH-Port" "$DEF_PORT")}"
SRV_USER="${OPT_USER:-$(ask_required "SSH-Benutzer")}"
REMOTE_PATH="${OPT_PATH:-$(ask_required "Remote-Pfad auf dem Server" "$DEF_PATH")}"
ENV_BRANCH="${OPT_BRANCH:-$(ask_required "Branch für diese Umgebung" "$DEF_BRANCH")}"
SRV_ACCOUNT="${OPT_ACCOUNT:-$(ask_required "Server-Account für Key-Benennung (z.B. revolte-labor)" "$DEF_ACCOUNT")}"
SRV_ACCOUNT=$(lower "$SRV_ACCOUNT")

echo ""
info "Profil:      $PROFIL"
info "Server:      ${SRV_USER}@${SRV_HOST}:${SRV_PORT}"
info "Remote-Pfad: $REMOTE_PATH"
info "Branch:      $ENV_BRANCH"
info "Key-Account: $SRV_ACCOUNT (Key: ${KUERZEL}_${SRV_ACCOUNT}_ed25519)"
echo ""
confirm "Alles korrekt?" || err "Abgebrochen — Werte per Flags oder erneutem Aufruf korrigieren."

# ── ddev muss laufen (Agent-/Container-Schritte) ─────────────────────────────
ddev describe >/dev/null 2>&1 || err "ddev läuft nicht — bitte zuerst 'ddev start' ausführen."

# ── Schritt 1: SSH-Key ────────────────────────────────────────────────────────
step "1/6 SSH-Key"

if [[ -n "$OPT_KEY" ]]; then
    KEY_PATH="${OPT_KEY/#\~/$HOME}"
    [[ -f "$KEY_PATH" ]] || err "Key nicht gefunden: $KEY_PATH"
else
    KEY_PATH="${HOME}/.ssh/${KUERZEL}_${SRV_ACCOUNT}_ed25519"
fi
KEY_NAME=$(basename "$KEY_PATH")

if [[ -f "$KEY_PATH" ]]; then
    ok "Key vorhanden: $KEY_PATH"
else
    info "Erzeuge neuen Key: $KEY_PATH"
    echo "    (ssh-keygen fragt jetzt die Passphrase ab — 2× eingeben, gut merken)"
    echo ""
    ssh-keygen -t ed25519 -f "$KEY_PATH" -C "${KUERZEL}-${SRV_ACCOUNT}"
    ok "Key erzeugt."
fi

[[ -f "${KEY_PATH}.pub" ]] || err "Public Key fehlt: ${KEY_PATH}.pub"
PUBKEY=$(cat "${KEY_PATH}.pub")

# ── Schritt 2: ~/.ssh/config (Host) ──────────────────────────────────────────
step "2/6 ~/.ssh/config (Host)"

mkdir -p "${HOME}/.ssh"
touch "$SSH_CONFIG"
chmod 600 "$SSH_CONFIG"

write_host_block() {
    cat >> "$SSH_CONFIG" <<EOF

Host ${PROFIL}
    HostName ${SRV_HOST}
    Port ${SRV_PORT}
    User ${SRV_USER}
    IdentityFile ${KEY_PATH}
    IdentitiesOnly yes
EOF
}

if profile_exists_in "$SSH_CONFIG" "$PROFIL"; then
    CUR_HOST=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "hostname")
    CUR_PORT=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "port"); CUR_PORT="${CUR_PORT:-22}"
    CUR_USER=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "user")
    CUR_KEY=$(get_profile_field "$SSH_CONFIG" "$PROFIL" "identityfile"); CUR_KEY="${CUR_KEY/#\~/$HOME}"
    CUR_IDONLY=$(lower "$(get_profile_field "$SSH_CONFIG" "$PROFIL" "identitiesonly")")

    if [[ "$CUR_HOST" == "$SRV_HOST" && "$CUR_PORT" == "$SRV_PORT" && "$CUR_USER" == "$SRV_USER" \
          && "$CUR_KEY" == "$KEY_PATH" && "$CUR_IDONLY" == "yes" ]]; then
        ok "Profil '$PROFIL' bereits korrekt eingetragen."
    else
        warn "Profil '$PROFIL' vorhanden, weicht aber ab:"
        echo "      aktuell: ${CUR_USER:-?}@${CUR_HOST:-?}:${CUR_PORT}  Key: ${CUR_KEY:-(keiner)}  IdentitiesOnly: ${CUR_IDONLY:-nein}"
        echo "      neu:     ${SRV_USER}@${SRV_HOST}:${SRV_PORT}  Key: ${KEY_PATH}  IdentitiesOnly: yes"
        if confirm "Profil auf die neuen Werte umschreiben?"; then
            drop_profile_block "$SSH_CONFIG" "$PROFIL"
            chmod 600 "$SSH_CONFIG"
            write_host_block
            ok "Profil aktualisiert."
        else
            warn "Profil unverändert gelassen — Setup nutzt die BESTEHENDEN Werte."
            SRV_HOST="${CUR_HOST:-$SRV_HOST}"; SRV_PORT="${CUR_PORT:-$SRV_PORT}"; SRV_USER="${CUR_USER:-$SRV_USER}"
            if [[ -n "$CUR_KEY" && -f "$CUR_KEY" ]]; then
                KEY_PATH="$CUR_KEY"; KEY_NAME=$(basename "$KEY_PATH")
                PUBKEY=$(cat "${KEY_PATH}.pub" 2>/dev/null) || err "Public Key fehlt: ${KEY_PATH}.pub"
            fi
        fi
    fi
else
    write_host_block
    ok "Profil '$PROFIL' eingetragen."
fi

# ── Schritt 3: Container-Config (homeadditions) ──────────────────────────────
step "3/6 Container-Config (ddev homeadditions)"

mkdir -p "$(dirname "$HOMEADD_CONF")" "$HOMEADD_KEYDIR"
touch "$HOMEADD_CONF"

HOMEADD_CHANGED=0

# Public Key in den Container spiegeln (nur der Public Key!)
if ! cmp -s "${KEY_PATH}.pub" "${HOMEADD_KEYDIR}/${KEY_NAME}.pub" 2>/dev/null; then
    cp "${KEY_PATH}.pub" "${HOMEADD_KEYDIR}/${KEY_NAME}.pub"
    HOMEADD_CHANGED=1
fi

write_container_block() {
    cat >> "$HOMEADD_CONF" <<EOF

Host ${PROFIL}
    HostName ${SRV_HOST}
    Port ${SRV_PORT}
    User ${SRV_USER}
    IdentityFile ~/.ssh/revolte-keys/${KEY_NAME}.pub
    IdentitiesOnly yes
EOF
}

C_OK=0
if profile_exists_in "$HOMEADD_CONF" "$PROFIL"; then
    C_HOST=$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "hostname")
    C_PORT=$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "port"); C_PORT="${C_PORT:-22}"
    C_USER=$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "user")
    C_IDFILE=$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "identityfile")
    C_IDONLY=$(lower "$(get_profile_field "$HOMEADD_CONF" "$PROFIL" "identitiesonly")")
    if [[ "$C_HOST" == "$SRV_HOST" && "$C_PORT" == "$SRV_PORT" && "$C_USER" == "$SRV_USER" \
          && "$C_IDFILE" == "~/.ssh/revolte-keys/${KEY_NAME}.pub" && "$C_IDONLY" == "yes" ]]; then
        C_OK=1
    fi
fi

if [[ "$C_OK" -eq 1 ]]; then
    ok "Container-Profil '$PROFIL' bereits korrekt (ein Key, IdentitiesOnly)."
else
    drop_profile_block "$HOMEADD_CONF" "$PROFIL"
    write_container_block
    HOMEADD_CHANGED=1
    ok "Container-Profil '$PROFIL' geschrieben (bietet genau EINEN Key an — fail2ban-Schutz)."
fi

# Entwicklerspezifisch → gehört nicht ins Git
if [[ -f ".gitignore" ]] && grep -qxF "/.ddev/homeadditions/.ssh/" .gitignore 2>/dev/null; then
    :
else
    {
        echo ""
        echo "# revolte-ssh-setup: entwicklerspezifische SSH-Profile (nicht committen)"
        echo "/.ddev/homeadditions/.ssh/"
    } >> .gitignore
    ok "/.ddev/homeadditions/.ssh/ in .gitignore aufgenommen."
fi

if git rev-parse --git-dir >/dev/null 2>&1 && git ls-files --error-unmatch "$HOMEADD_CONF" >/dev/null 2>&1; then
    warn "Achtung: $HOMEADD_CONF ist bereits in Git getrackt (alte Einrichtung)."
    echo "      → einmalig ausführen: git rm -r --cached .ddev/homeadditions/.ssh && git commit"
fi

if [[ "$HOMEADD_CHANGED" -eq 1 ]]; then
    info "homeadditions geändert — ddev restart nötig, wird jetzt ausgeführt ..."
    ddev restart
    ok "ddev neu gestartet."
fi

# ── Schritt 4: Key im ddev-Agent ─────────────────────────────────────────────
step "4/6 Key im ddev-Agent"

KEY_FP=$(ssh-keygen -lf "${KEY_PATH}.pub" 2>/dev/null | awk '{print $2}')
AGENT_KEYS=$(ddev exec ssh-add -l 2>/dev/null || true)

if [[ -n "$KEY_FP" ]] && echo "$AGENT_KEYS" | grep -q "$KEY_FP"; then
    ok "Key '$KEY_NAME' ist im ddev-Agent geladen."
else
    info "Lade Keys in den ddev-Agent (ddev auth ssh) ..."
    echo "    (Jetzt kommt die Passphrase-Abfrage für deine Keys — das ist die"
    echo "     einzige Stelle außer ssh-keygen, an der eine Passphrase gefragt wird.)"
    echo ""
    ddev auth ssh
    AGENT_KEYS=$(ddev exec ssh-add -l 2>/dev/null || true)
    if [[ -n "$KEY_FP" ]] && echo "$AGENT_KEYS" | grep -q "$KEY_FP"; then
        ok "Key '$KEY_NAME' ist im ddev-Agent."
    else
        err "Key '$KEY_NAME' nicht im ddev-Agent gefunden.
    Geladene Keys:
$AGENT_KEYS
    Der Key muss direkt in ~/.ssh/ liegen (kein Unterordner) und die
    Passphrase korrekt eingegeben werden. Dann Script erneut starten."
    fi
fi

# ── Schritt 5: Public Key auf dem Server + revolte_deploy.yaml ───────────────
step "5/6 Public Key auf dem Server"

KEY_INSTALLED=0

if confirm "Ist der Public Key bereits auf dem Server hinterlegt (früherer Lauf / Hosting-Panel)?"; then
    ok "Key-Eintrag wird übersprungen."
    KEY_INSTALLED=1
else
    # Kandidaten aus ~/.ssh/config anzeigen — OHNE sie per SSH durchzuprobieren
    CANDIDATES=$(awk -v host="$SRV_HOST" -v port="$SRV_PORT" -v skip="$PROFIL" '
        /^Host[[:space:]]/ { p = $2; hn = ""; pt = "22" }
        tolower($1) == "hostname" { hn = $2 }
        tolower($1) == "port"     { pt = $2 }
        hn == host && pt == port && p != skip && !seen[p]++ { print p }
    ' "$SSH_CONFIG" 2>/dev/null || true)

    WORKING_PROFILE=""
    if [[ -n "$CANDIDATES" ]]; then
        echo ""
        info "Profile für denselben Server in ~/.ssh/config:"
        echo "$CANDIDATES" | while IFS= read -r c; do echo "      $c"; done
        echo ""
        echo "   Falls eines davon bei dir FUNKTIONIERT, kann der neue Key darüber"
        echo "   automatisch eingetragen werden (genau 1 Verbindung)."
        WORKING_PROFILE=$(ask "Funktionierendes Profil (Enter = keins)")
    fi

    if [[ -n "$WORKING_PROFILE" ]]; then
        info "Trage Key über '$WORKING_PROFILE' ein ..."
        if ddev exec ssh -o BatchMode=yes -o ConnectTimeout=10 "$WORKING_PROFILE" \
            "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && grep -qxF '${PUBKEY}' ~/.ssh/authorized_keys || echo '${PUBKEY}' >> ~/.ssh/authorized_keys"; then
            ok "Key eingetragen über '$WORKING_PROFILE'."
            KEY_INSTALLED=1
        else
            warn "Eintrag über '$WORKING_PROFILE' fehlgeschlagen — bitte manuell (siehe unten)."
        fi
    fi

    if [[ "$KEY_INSTALLED" -eq 0 ]]; then
        echo ""
        info "Key manuell hinterlegen — zwei Möglichkeiten:"
        echo ""
        echo "   A) Hosting-Panel (z.B. Hetzner konsoleH): diesen Public Key eintragen:"
        echo ""
        echo "      ${PUBKEY}"
        echo ""
        echo "   B) Per Passwort-Login (fragt EINMAL das Server-Passwort ab):"
        echo ""
        echo "      ddev exec ssh -o PubkeyAuthentication=no ${PROFIL} \"mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && echo '${PUBKEY}' >> ~/.ssh/authorized_keys\""
        echo ""
        echo -e "   ${Y}Hinweis:${NC} Bei falschem Passwort NICHT sofort neu probieren (fail2ban)."
        echo ""
        read -r -p " Enter drücken, wenn der Key hinterlegt ist ... "
        KEY_INSTALLED=1
    fi
fi

# ── revolte_deploy.yaml ───────────────────────────────────────────────────────
step "revolte_deploy.yaml"

if [[ ! -f "$YAML_FILE" ]]; then
    warn "$YAML_FILE nicht gefunden — Eintrag übersprungen."
    warn "Vorlage: cp vendor/revolte/contao-deploy-tools/resources/revolte_deploy.yaml.dist $YAML_FILE"
    warn "Danach Script erneut ausführen — der Eintrag wird dann ergänzt."
elif grep -q "^  ${ENV_NAME}:" "$YAML_FILE"; then
    CUR_YPROFIL=$(awk -v env="$ENV_NAME" '
        /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
        in_env && /^    ssh_profile: / { sub(/^    ssh_profile: /, ""); print; exit }
    ' "$YAML_FILE")
    CUR_YPATH=$(awk -v env="$ENV_NAME" '
        /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
        in_env && /^    remote_path: / { sub(/^    remote_path: /, ""); print; exit }
    ' "$YAML_FILE")
    CUR_YBRANCH=$(awk -v env="$ENV_NAME" '
        /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
        in_env && /^    branch: / { sub(/^    branch: /, ""); print; exit }
    ' "$YAML_FILE")

    if [[ "$CUR_YPROFIL" == "$PROFIL" && "$CUR_YPATH" == "$REMOTE_PATH" && "$CUR_YBRANCH" == "$ENV_BRANCH" ]]; then
        ok "Umgebung '$ENV_NAME' bereits korrekt eingetragen."
    else
        warn "Umgebung '$ENV_NAME' eingetragen, weicht aber ab:"
        echo "      aktuell: profil=${CUR_YPROFIL:-?}  pfad=${CUR_YPATH:-?}  branch=${CUR_YBRANCH:-?}"
        echo "      neu:     profil=${PROFIL}  pfad=${REMOTE_PATH}  branch=${ENV_BRANCH}"
        if confirm "Auf die neuen Werte aktualisieren?"; then
            tmp=$(mktemp)
            awk -v env="$ENV_NAME" -v new_profil="$PROFIL" -v new_path="$REMOTE_PATH" -v new_branch="$ENV_BRANCH" '
                /^  [a-zA-Z0-9_-]+:/ { in_env = ($0 ~ ("^  " env ":")) }
                in_env && /^    ssh_profile: / { print "    ssh_profile: " new_profil; next }
                in_env && /^    remote_path: / { print "    remote_path: " new_path;   next }
                in_env && /^    branch: /      { print "    branch: "      new_branch; next }
                { print }
            ' "$YAML_FILE" > "$tmp" && mv "$tmp" "$YAML_FILE"
            ok "Umgebung '$ENV_NAME' aktualisiert."
        else
            ok "Keine Änderung an $YAML_FILE."
        fi
    fi
else
    info "Trage Umgebung '$ENV_NAME' ein ..."
    tmp=$(mktemp)
    awk -v env="$ENV_NAME" -v profil="$PROFIL" -v path="$REMOTE_PATH" -v branch="$ENV_BRANCH" '
        /^environments:/ {
            print
            print "  " env ":"
            print "    ssh_profile: " profil
            print "    remote_path: " path
            print "    branch: " branch
            print "    allowed_branches:"
            print "      - " branch
            print "    php_cli: auto"
            next
        }
        { print }
    ' "$YAML_FILE" > "$tmp" && mv "$tmp" "$YAML_FILE"
    ok "Umgebung '$ENV_NAME' eingetragen."
    warn "Bitte allowed_branches in $YAML_FILE prüfen und bei Bedarf erweitern."
fi

# ── Team-Defaults anbieten (nur stage, nur wenn noch keine existieren) ────────
if [[ "$ENV_NAME" == "stage" && -z "$STAGE_HOST" ]]; then
    echo ""
    if confirm "Diese Stage-Werte als Team-Defaults speichern (füllt künftige Setups vor)?"; then
        PATH_TEMPLATE="${REMOTE_PATH//$PROJECT_NAME/\{project\}}"
        {
            echo "# revolte-ssh-setup Team-Defaults (Stage) — automatisch erzeugt"
            echo "STAGE_HOST=${SRV_HOST}"
            echo "STAGE_PORT=${SRV_PORT}"
            echo "STAGE_ACCOUNT=${SRV_ACCOUNT}"
            echo "STAGE_PATH_TEMPLATE=${PATH_TEMPLATE}"
        } > "$TEAM_CONF"
        ok "Gespeichert in $TEAM_CONF."
    fi
fi

# ── Schritt 6: Verbindungstest (genau EIN Versuch) ───────────────────────────
step "6/6 Verbindungstest"

TEST_RESULT=0

if [[ "$SKIP_TEST" -eq 1 ]]; then
    info "Übersprungen (--skip-test). Später prüfen mit: vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
else
    REST=$(cooldown_remaining_min)
    if [[ "$REST" -gt 0 ]]; then
        warn "Cooldown aktiv: noch ${REST} min seit dem letzten Fehlversuch auf ${SRV_HOST}:${SRV_PORT}."
        warn "Kein Verbindungstest (fail2ban-Schutz). Später: vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
        TEST_RESULT=1
    else
        run_connection_test || TEST_RESULT=$?
    fi
fi

# ── Fertig ────────────────────────────────────────────────────────────────────
echo ""
if [[ "$TEST_RESULT" -eq 0 && "$SKIP_TEST" -eq 0 ]]; then
    echo -e "${G}=== SSH-Einrichtung abgeschlossen — Profil '$PROFIL' ist einsatzbereit ===${NC}"
    echo ""
    info "Nächste Schritte:"
    echo "   1. ddev exec php vendor/bin/contao-console revolte:deploy:doctor --env=dev"
    echo "   2. ddev exec php vendor/bin/contao-console revolte:deploy:check $ENV_NAME --env=dev"
    echo "   3. ddev exec php vendor/bin/contao-console revolte:deploy:init $ENV_NAME --env=dev"
    exit 0
else
    echo -e "${Y}=== Einrichtung gespeichert, Verbindung noch offen ===${NC}"
    echo ""
    info "Alle lokalen Einstellungen sind persistiert. Sobald der Verbindungsweg"
    info "geklärt ist (Key auf Server / Cooldown abgelaufen):"
    echo "   vendor/bin/revolte-ssh-setup ${ENV_NAME} --check"
    exit 1
fi
